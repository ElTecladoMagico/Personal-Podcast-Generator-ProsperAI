# /opt/podcast/.env on the VPS (chmod 600). Never commit the real file.
POSTGRES_USER=podcast
POSTGRES_PASSWORD=<random>
POSTGRES_DB=podcast
DATABASE_URL=postgresql+psycopg://podcast:<random>@podcast-postgres:5432/podcast
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
GUARDIAN_API_KEY=test
CLERK_ISSUER=https://sure-pipefish-8631.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=https://podcast.scuda.es,https://scuda-podcast.netlify.app
