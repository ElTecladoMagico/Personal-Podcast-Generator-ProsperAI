PUBLIC_BASE_URL=https://api.podcast.scuda.es
AUDIO_DIR=/data/audio
SCHEDULER_ENABLED=true
MAX_CONCURRENT_GENERATIONS=3
EPISODE_MAX_MINUTES=10
MAX_MANUAL_EPISODES_PER_DAY=5
