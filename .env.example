# Backend settings. Copy to .env (never commit .env).
DATABASE_URL=postgresql+psycopg://podcast:podcast@localhost:5433/podcast
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
EXA_API_KEY=...
# Clerk "Frontend API URL"; JWKS is read from {issuer}/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://podcast.scuda.es
CORS_ORIGINS=http://localhost:5173,https://podcast.scuda.es
PUBLIC_BASE_URL=http://localhost:8000
AUDIO_DIR=./data/audio
SCHEDULER_ENABLED=true
MAX_CONCURRENT_GENERATIONS=3
EPISODE_MAX_MINUTES=2
MAX_MANUAL_EPISODES_PER_DAY=5
