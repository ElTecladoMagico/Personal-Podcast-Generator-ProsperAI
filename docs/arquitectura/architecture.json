  "cards": [
    {
      "dot": "cyan",
      "title": "Episode pipeline (newsroom)",
      "items": [
        "1 Reporter: up to 60 candidates from Google News, Exa and Hacker News",
        "2 Editor LLM: picks the stories (interest weights, novelty, past 👍/👎 and skips)",
        "3 Research: full text of the picked stories (Exa text or scraping, 48 h cache)",
        "4 Writer LLM: chapters and turns, every fact tied to an article id",
        "5 Fact-checker LLM: flags unsupported claims, one rewrite, the rest removed",
        "6 Voices: ElevenLabs dialogue in parallel chunks, word timestamps, ×1.1"
      ]
    },
    {
      "dot": "emerald",
      "title": "State & persistence",
      "items": [
        "episode.status + work drive live progress, resume after a crash and retries",
        "events table feeds the editor (feedback) and the /admin dashboard",
        "FastAPI serves mp3 + private RSS from the volume (feed token as credential)",
        "Ask the hosts: chapter sources → short LLM answer → same voices, then resume"
      ]
    },
    {
      "dot": "violet",
      "title": "Deliberate simplifications",
      "items": [
        "One process: scheduler thread + 3-thread pipeline pool inside the API",
        "No queue or object storage: Postgres (unique index = one episode at a time) + disk",
        "Progress via 1.5 s polling; metrics are SQL on the fly, no warehouse",
        "Upgrade path: Cloud Run + managed Postgres + R2 + a Postgres job queue"
      ]
    }
  ]
