  "cards": [
    {
      "dot": "cyan",
      "title": "Episode pipeline (newsroom)",
      "items": [
        "1 Reporter: ~40 candidate headlines per user",
        "2 Editor LLM: picks 5–7 stories (interests, novelty, already covered, feedback)",
        "3 Research: scrapes full text of picked stories only",
        "4 Scriptwriter LLM: JSON chapters + turns with sourceIds",
        "5 Hosts: ElevenLabs per chapter, timestamps for synced transcript"
      ]
    },
    {
      "dot": "emerald",
      "title": "State & persistence",
      "items": [
        "episode.status drives live progress UI, retries and ops metrics",
        "events table feeds personalization and the /admin dashboard",
        "FastAPI serves mp3 + RSS from the audio volume"
      ]
    },
    {
      "dot": "violet",
      "title": "Deliberate simplifications",
      "items": [
        "Single VPS: scheduler and pipeline run in the API process",
        "No queue, no object storage, no ffmpeg",
        "Upgrade path: Cloud Run + managed Postgres + R2 + Cloud Scheduler"
      ]
    }
  ]
